# Leave unset for a persistent local workspace. PostgreSQL is recommended for deployment.
# DATABASE_URL=postgres://smartbiz:smartbiz@localhost:5432/smartbiz
PORT=3001
# The local development fallback is smartbiz-owner. Always set a private password for shared or public use.
# AUTH_PASSWORD=replace-with-a-private-password
# Optional connected advisor. Copy this file to .env, add your own key, then restart.
# .env is loaded only by the server and is ignored by Git.
# OPENAI_API_KEY=your-own-api-key
# OPENAI_MODEL=your-enabled-model-id
